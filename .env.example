# Nuvora Demand Engine - local development environment variables.
# Copy this file to .env for local development. Never commit .env or real secrets.

# Core
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (local development only)
POSTGRES_DB=demand_engine
POSTGRES_USER=demand_engine
POSTGRES_PASSWORD=demand_engine_dev

# Connection URL used by the API and Alembic. Host port 5433 is used by
# docker-compose.yml to avoid clashing with another local PostgreSQL on 5432.
DATABASE_URL=postgresql+psycopg://demand_engine:demand_engine_dev@localhost:5433/demand_engine
# DB_CONNECT_TIMEOUT=5

# Reserved for future AI analysis phases. Not used in P0-002.
# OPENAI_API_KEY=
# LLM_MODEL=
